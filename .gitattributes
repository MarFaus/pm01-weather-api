* text=auto eol=lf

# cmd.exe понимает только CRLF: с LF метки и goto в батниках ломаются.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
